<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dati di mercato Binance (endpoint pubblici) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Avvisi prezzo: notifiche + servizio realtime + avvio al boot -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse: unico tipo FGS che Android 15 permette di avviare da
         BOOT_COMPLETED; dataSync da boot lancia ForegroundServiceStartNotAllowedException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".TraderApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdgentTrader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AdgentTrader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link dai widget e dalle notifiche: adgent://coin/BTCUSDT -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="adgent" android:host="coin" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.service.PriceFeedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="crypto_price_alerts_realtime_feed" />
        </service>

        <receiver
            android:name=".core.service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Azione rapida "Disattiva" dalle notifiche avviso -->
        <receiver
            android:name=".core.notifications.AlertActionReceiver"
            android:exported="false" />

        <!-- Widget home screen (F4) -->
        <!-- Configurazione per-istanza: simbolo, testo, formato numeri, refresh. -->
        <activity
            android:name=".ui.widgets.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.AdgentTrader">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ui.widgets.TickerWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_ticker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ticker_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.widgets.WatchlistWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_watchlist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchlist_widget_info" />
        </receiver>
    </application>

</manifest>
